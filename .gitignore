# Runtime settings can contain administrator-supplied keys, tokens, buyer data, and logs.
.env
.env.*
!.env.example
**/config.json
**/data/
**/logs/
*.log
.pi/
.playwright-cli/

# Dependencies and generated caches.
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
**/.coverage
**/htmlcov/
**/.ruff_cache/
**/.mypy_cache/
**/.tox/
coverage/

# Local inspection, release packages, and generated artifacts.
.tmp/
.tmp-*/
/tmp-*
/nul
.v3-deploy-candidate/
output/
dist/
*.tar.gz
*.tgz
*.zip
**/*.tmp

# Runtime and production data.
**/*.sqlite
**/*.sqlite3
**/*.db
**/uploads/
**/sessions/
**/*.pid
**/*.lock

# Credentials and key material.
*.pem
*.key
id_rsa*
id_ed25519*
id_windsurf*

# OS/editor files.
.DS_Store
Thumbs.db
.vscode/
.idea/
