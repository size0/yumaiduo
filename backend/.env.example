# 不要把真实密钥提交到 Git。
# Ubuntu 必填：Base64 编码的 32 字节随机值，用于 AES-GCM 保护持久化敏感数据。
WANDA_SETTINGS_ENCRYPTION_KEY=base64_32_byte_key
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-flash-2026-02-23
DASHSCOPE_CHAT_API_KEY=sk-your-separate-chat-key-here
DASHSCOPE_CHAT_BASE_URL=https://airelvo.cc/v1
DASHSCOPE_CHAT_MODEL=qwen3.5-flash-2026-02-23
CHAT_MAX_COMPLETION_TOKENS=3000
CHAT_CONTEXT_MESSAGES=12
DASHSCOPE_ENABLE_THINKING=false
DASHSCOPE_REASONING_EFFORT=none
WANDA_ACCOUNT_POOL_PATH=E:/票务系统/backend/data/accounts.json
WANDA_CINEMA_CACHE_PATH=E:/票务系统/backend/data/cinema_cache.sqlite
WANDA_FIXED_ACCOUNT_PHONE=
WANDA_REQUEST_TIMEOUT_SECONDS=12
# 良票官方截图识别接口；生产环境通过密钥管理设施注入真实凭据。
LIANGPIAO_BASE_URL=https://portal-web-v3.liangpiao.net.cn
LIANGPIAO_APP_KEY=
LIANGPIAO_APP_SECRET=
LIANGPIAO_REQUEST_TIMEOUT_SECONDS=20
# Async recognition prevents one synchronous provider call from blocking other buyers.
LIANGPIAO_RECOGNITION_ASYNC_ENABLED=false
LIANGPIAO_RECOGNITION_POLL_INTERVAL_SECONDS=1
LIANGPIAO_RECOGNITION_POLL_TIMEOUT_SECONDS=120
RULES_FIRST_MAX_CONCURRENT_EVENTS=8
LIANGPIAO_SELECTED_SEAT_QUOTE_ENABLED=false
LIANGPIAO_ORDER_CREATE_ENABLED=false
# 良票 order/create 必填的购票预留手机号；未配置时自动下单会安全转人工。
LIANGPIAO_ORDER_PHONE=
EXTERNAL_WRITES_ENABLED=false
# Reset phase: allow read-only Agent replies, fuse transaction writes closed.
AGENT_HARNESS_READ_ONLY=true
# Explicit gray-path switch; keep false until the new read-only Harness is accepted.
NEW_AGENT_HARNESS_ENABLED=false
# Active Probe creates/locks temporary provider orders; keep independently disabled.
WANDA_ACTIVE_PROBE_ENABLED=false
LIANGPIAO_CALLBACK_ENABLED=false
WANDA_PRICING_RULES_PATH=data/pricing-rules.json
WANDA_SHOP_AUTOMATION_PATH=data/shop-automation.json
WANDA_REPLY_TEMPLATES_PATH=data/reply-templates.json
WANDA_CONVERSATION_POLICY_PATH=data/conversation-policy.json
WANDA_QUOTE_RECORDS_PATH=data/quote-records.json
WANDA_REMINDERS_PATH=data/reminders.json
WANDA_KEYWORD_IMAGES_PATH=data/keyword-images
WANDA_PENDING_CANDIDATES_PATH=data/pending-recognition-candidates.json
# 唯一规则运行库；SQLite WAL，敏感载荷继续由SecretProtector加密。
WANDA_RULES_DB_PATH=data/rules-first.sqlite3
WANDA_RECOGNITION_SNAPSHOTS_PATH=data/recognition-snapshots.sqlite3
# AI辅助关闭后，图片改走结构化文字采集，固定交易规则仍继续。
WANDA_AI_ASSIST_ENABLED=true
# 外部平台写操作紧急熔断；关闭后不切换旧引擎。
WANDA_EXTERNAL_WRITES_ENABLED=false
# 插件桥接共享密钥必须使用随机高强度值；生产环境由密钥管理设施注入。
WANDA_AI_V2_BRIDGE_KEY=
MAX_IMAGE_BYTES=10485760
MODEL_TIMEOUT_SECONDS=60
