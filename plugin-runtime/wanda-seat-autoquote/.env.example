# Official platform connection. The runtime injects real values in production.
CORE_URL=http://127.0.0.1:3000
PLUGIN_DEVELOPER_TOKEN=pdk_replace_me
PLUGIN_BASE_URL=http://127.0.0.1:4003
HOST=0.0.0.0
PORT=4003

# Independent Wanda AI V2 backend. These values are not compatible with any prior runtime.
WANDA_AI_V2_BACKEND_URL=http://127.0.0.1:8000
WANDA_AI_V2_BRIDGE_KEY=replace_me
WANDA_AI_V2_DATA_DIR=data/v2
CONFIG_ENCRYPTION_KEY=base64_32_byte_key

# Optional read-only API for the downstream Wanda ticket-issuing system.
# Keep the key and tenant binding in the deployment environment, never in Git.
WANDA_ORDER_API_KEY=
WANDA_ORDER_API_TENANT_ID=
# Keep false until the issuing-system smoke test is approved.
WANDA_ORDER_FULFILLMENT_ENABLED=false

# Optional durable order-event handoff and signed fulfillment-receipt callback
# from the ticket system.
# ORDER_EVENT_OUTBOX_KEY is the tenant HMAC secret configured by the ticket
# system; ORDER_EVENT_OUTBOX_BRIDGE_KEY is its global plugin bridge key.
# Leave all three blank to keep events persisted locally without delivery.
ORDER_EVENT_OUTBOX_URL=
# Optional signed callback endpoint for post-acceptance shipping/message status.
# Example: https://ticket.example/api/integration/orders/wanda/{order_id}/fulfillment-delivery/status
ORDER_FULFILLMENT_STATUS_URL=
ORDER_EVENT_OUTBOX_KEY=
ORDER_EVENT_OUTBOX_BRIDGE_KEY=

REQUEST_TIMEOUT_MS=90000
MAX_WEBHOOK_BODY_BYTES=1048576
WANDA_AI_V2_MAX_CONCURRENT_RUNS=12
LOG_LEVEL=info
