{
  "id": "wanda-seat-autoquote",
  "name": "万达电影票 AI 客服 V4",
  "version": "2.2.51",
  "type": "plugin",
  "vendor": "xdl",
  "engines": {
    "yumaiduoCore": ">=0.1.0"
  },
  "entrypoint": {
    "server": "index.mjs",
    "web": "/ui",
    "crossOriginUi": true,
    "webhookPath": "/__plugin__/webhook"
  },
  "runtime": {
    "port": 4003,
    "baseUrl": "http://127.0.0.1:4003"
  },
  "entitlement": {
    "feature": "plugin.wanda-seat-autoquote",
    "trialEligible": true
  },
  "permissions": [
    "order.read",
    "order.write.price_change",
    "order.write.cancel",
    "order.write.ship",
    "account.read",
    "im.session.read",
    "im.message.read",
    "im.message.send"
  ],
  "extensionPoints": {
    "menu": [
      {
        "section": "plugins",
        "label": "万达AI客服",
        "title": "万达AI客服 V4",
        "to": "/console/plugins/wanda-seat-autoquote/dashboard",
        "icon": "ticket"
      }
    ],
    "routes": [
      {
        "path": "/console/plugins/wanda-seat-autoquote/dashboard",
        "title": "万达AI客服 V4",
        "component": "/api/v1/plugin/wanda-seat-autoquote/gateway/ui",
        "entry": "/api/v1/plugin/wanda-seat-autoquote/gateway/ui"
      }
    ],
    "subscribes": [
      "im.message.received",
      "order.created",
      "order.price.changed",
      "order.paid",
      "order.shipped",
      "order.finished",
      "order.refund.applied",
      "order.refund.finished",
      "order.closed"
    ]
  }
}
