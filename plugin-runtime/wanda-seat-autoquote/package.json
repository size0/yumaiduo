    "vendor/plugin-sdk-server/package.json",
    "vendor/plugin-sdk-server/dist/*.js",
    "yumaiduo.plugin.json",
    "Dockerfile",
    "README.md",
    "docs/V2_ARCHITECTURE.md"
  ],
  "dependencies": {
    "@yumaiduo/plugin-sdk-server": "file:vendor/plugin-sdk-server"
  }
}
