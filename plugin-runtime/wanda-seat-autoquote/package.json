{
  "name": "@xdl/wanda-seat-autoquote",
  "version": "2.2.50",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "verify:runtime-deps": "node scripts/verify-runtime-deps.mjs",
    "check": "npm run test && npm run verify:runtime-deps && npm pack --dry-run --json"
  },
  "files": [
